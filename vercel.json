{
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/reviews",
      "schedule": "0 3 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "kiosk.kokonipetsalon.com" }],
      "destination": "/kiosk",
      "permanent": false
    }
  ]
}
