# ─── SMS mode control ──────────────────────────────────────────
# live → real customers get texts (production)
# test → only numbers in SMS_TEST_WHITELIST get texts; everyone else is logged
# off  → nothing sends at all; still logs what would have been sent
SMS_MODE=test

# Comma-separated list of phone numbers allowed to receive texts in test mode.
# Use E.164 format: +1XXXXXXXXXX
SMS_TEST_WHITELIST=+19495089155

# (Optional) In test mode, redirect EVERY outgoing SMS to this one number.
# Useful for verifying real Twilio delivery on your own phone without whitelisting.
# Leave blank to use the whitelist instead.
# SMS_TEST_FORWARD=+19495089155
